# Local development defaults are used when TRUSTVAULT_ENV is not production.
# Do not commit your real .env file or actual secrets.

# Required in production (must be different secrets, 32+ characters each):
TRUSTVAULT_ENV=production
TRUSTVAULT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TRUSTVAULT_AUDIT_KEY=replace-with-a-different-random-secret-at-least-32-characters

# Required only on first production startup if the database has no users:
TRUSTVAULT_BOOTSTRAP_ADMIN_USERNAME=choose_admin_username
TRUSTVAULT_BOOTSTRAP_ADMIN_PASSWORD=choose_a_random_password_at_least_16_chars

TRUSTVAULT_DB=/var/data/trustvault.db
TRUSTVAULT_STORAGE=/var/data/trustvault-files
COOKIE_SECURE=1
MAX_UPLOAD_BYTES=5242880
PORT=8000
